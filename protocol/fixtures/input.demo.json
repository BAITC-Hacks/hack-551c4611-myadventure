    { "id": "seg-3", "speakerId": "SPEAKER_01", "start": 12, "end": 16, "text": "Можно было бы когда-нибудь автоматизировать рассылку.", "language": "ru" },
    { "id": "seg-4", "speakerId": "SPEAKER_00", "start": 16, "end": 22, "text": "Салтанат, проверьте список подрядчиков.", "language": "ru" },
    { "id": "seg-5", "speakerId": "SPEAKER_00", "start": 22, "end": 30, "text": "Асқар, осы аптада подрядчикпен сөйлесіп, новый график жасап беріңіз.", "language": "mixed" },
    { "id": "seg-6", "speakerId": "SPEAKER_00", "start": 30, "end": 36, "text": "Айгүл, жиналыс хаттамасын дайындаңыз.", "language": "kk" },
    { "id": "seg-7", "speakerId": "SPEAKER_00", "start": 36, "end": 42, "text": "Подготовьте также перечень рисков до 16 октября 2026 года. Ответственного определим позже.", "language": "ru" }

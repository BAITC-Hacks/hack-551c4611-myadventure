# Set this variable in the process environment; .env is not loaded automatically.
JINALYS_STT_MODEL_DIR=./speech/models/large-v3-turbo
# Defense in depth for deployments; model/tokenizer files must already exist.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# Optional local diarization: complete approved community-1 bundle.
JINALYS_DIARIZATION_MODEL_DIR=./speech/models/community-1
# Optional Python interpreter from a dedicated pyannote environment.
# JINALYS_DIARIZATION_PYTHON=./speech/.venv-diarization/Scripts/python.exe

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpeechPipelineResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["durationSeconds", "detectedSpeakers", "segments"],
  "properties": {
    "durationSeconds": { "type": "number" },
    "detectedSpeakers": { "type": "number" },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/definitions/TranscriptSegment" }
    }
  },
  "definitions": {
    "TranscriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speakerId", "start", "end", "text"],
      "properties": {
        "id": { "type": "string" },
        "speakerId": { "type": "string" },
        "speakerName": { "type": "string" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "text": { "type": "string" },
        "language": { "enum": ["ru", "kk", "mixed"], "type": "string" }
      }
    }
  }
}

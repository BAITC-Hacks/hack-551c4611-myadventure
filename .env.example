# Browser UI requires no env. Python server reads its process environment.
# Full setup: docs/LOCAL_RUN.md
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_TIMEOUT=600
JINALYS_STT_MODEL_DIR=./speech/models/large-v3-turbo
JINALYS_DIARIZATION_MODEL_DIR=./speech/models/community-1
JINALYS_DIARIZATION_PYTHON=./speech/.venv-diarization/Scripts/python.exe
# Windows pyannote: directory containing the complete FFmpeg shared DLL bundle.
# Set an actual absolute path in the server process; .env is not loaded automatically.
# JINALYS_FFMPEG_DIR=C:/tools/ffmpeg-shared/bin
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
